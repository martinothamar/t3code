# Selected Git identity values enter the Sandbox in plaintext. The token remains mediated.
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com
# Fine-grained PAT on martinothamar/t3code with Contents, Pull requests and Workflows read and
# write. Upstream syncs change .github/workflows, which GitHub refuses to accept without Workflows.
GITHUB_TOKEN=
# Optional. The aivar gateway's API key, passed on to nested `mini` Agents.
AIVAR_API_KEY=
