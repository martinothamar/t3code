[Unit]
Description=Secret service for the Agent desktop
# Electron's safeStorage needs an unlocked Secret Service. There is no login to unlock one, so the
# keyring has an empty password and is unlocked at start.
After=agent-desktop-dbus.service
Requires=agent-desktop-dbus.service

[Service]
Type=exec
User=agent
Group=agent
Environment=HOME=/home/agent
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/bin/sh -c 'printf "\\n" | exec /usr/bin/gnome-keyring-daemon --replace --foreground --unlock --components=secrets --control-directory=/run/user/1000/keyring'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
