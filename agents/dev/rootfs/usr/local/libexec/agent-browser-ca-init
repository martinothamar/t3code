#!/bin/sh
# Chromium and Electron take extra trust anchors from the user's NSS database rather than the system
# bundle, so they reject the network mediator's certificates until its CA is imported there.
set -eu

ca=${NODE_EXTRA_CA_CERTS:-/.msb/tls/ca.pem}
nssdb=$HOME/.pki/nssdb

remaining=30
while [ ! -r "$ca" ]; do
    if [ "$remaining" -eq 0 ]; then
        echo "mediator CA did not become readable within 30 seconds: $ca" >&2
        exit 1
    fi
    remaining=$((remaining - 1))
    sleep 1
done

mkdir -p "$nssdb"
[ -f "$nssdb/cert9.db" ] || certutil -N --empty-password -d "sql:$nssdb"
certutil -D -d "sql:$nssdb" -n agent-mediator-ca 2>/dev/null || true
certutil -A -d "sql:$nssdb" -n agent-mediator-ca -t 'C,,' -i "$ca"
