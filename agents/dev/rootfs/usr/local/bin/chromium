#!/bin/sh
# The desktop's browser: the Playwright Chromium build the image carries. Shared memory goes to
# the /tmp the Agent sizes instead of the small /dev/shm.
set -eu
for candidate in /opt/ms-playwright/chromium-*/chrome-linux*/chrome; do
    [ -x "$candidate" ] && exec "$candidate" \
        --no-first-run \
        --no-default-browser-check \
        --password-store=basic \
        --disable-dev-shm-usage \
        "$@"
done
echo "chromium: no Playwright Chromium under /opt/ms-playwright" >&2
exit 1
